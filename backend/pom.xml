<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file ("Project Object Model").

  Maven reads this file to know:
    * which libraries (dependencies) to download,
    * which Java version to compile for,
    * which plugins to run (e.g. the Spring Boot plugin that packages a runnable "fat" jar).

  Always build with the Maven Wrapper (./mvnw) that lives next to this file. The wrapper downloads
  the exact Maven version the project expects, so every developer and the CI server use the same one.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Inheriting from spring-boot-starter-parent gives us tested, compatible versions of ~hundreds of
      libraries (Hibernate, Jackson, JUnit, ...). That is why most dependencies below have no <version>.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.portfolio</groupId>
    <artifactId>library</artifactId>
    <version>1.0.0</version>
    <name>library</name>
    <description>Library Management System - REST API</description>

    <properties>
        <java.version>17</java.version>
        <!-- Versions for libraries that Spring Boot does NOT manage for us. -->
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.13</springdoc.version>
    </properties>

    <dependencies>
        <!-- REST controllers, JSON (Jackson) and an embedded Tomcat web server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- JPA/Hibernate: map Java classes (entities) to database tables; Spring Data repositories. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank, @Size, @Pattern ...) for request bodies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Security: authentication filter chain, password hashing, @PreAuthorize. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Flyway: versioned SQL migrations (src/main/resources/db/migration) run at startup. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10+ ships database support as separate modules; this one adds PostgreSQL. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- JJWT: create and verify JSON Web Tokens. Only the API is needed at compile time;
             the implementation and its Jackson JSON support are loaded at runtime. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Generates OpenAPI docs from the controllers and serves Swagger UI at /swagger-ui.html. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Databases: H2 (in-memory, for development and tests) and the PostgreSQL JDBC driver (production).
             "runtime" scope: our code never imports them directly, only JDBC does. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing: JUnit 5, Mockito, AssertJ, MockMvc ... plus helpers for testing secured endpoints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Packages everything (our code + all dependencies + Tomcat) into one runnable jar:
                 java -jar target/library-1.0.0.jar. Also provides ./mvnw spring-boot:run. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
